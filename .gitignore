# ===========================================================================
# .gitignore — Pomodoro To-Do App
# Clasificado por ámbito: dependencias, build, tests, secretos, entorno, SO, IDE
# Referencia: https://git-scm.com/docs/gitignore
# ===========================================================================

# --- Dependencias ----------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Build y artefactos de compilación -------------------------------------
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.vite/
.vite-cache/
.eslintcache
.cache/
.parcel-cache/

# --- Tests y cobertura -----------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
.vitest/

# --- Entorno y secretos (NUNCA versionar) ----------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json

# --- Logs ------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Configuración local del proyecto --------------------------------------
*.local
opencode.json

# --- Sistema operativo -----------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini

# --- Editores y IDE --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*~

# --- Artefactos de compilación ---------------------------------------------
# La fuente canónica en src/ es .ts/.tsx: los .js son salida de tsc y no se
# versionan (si aparecen de nuevo, borrarlos y no hacerles commit)
src/**/*.js
